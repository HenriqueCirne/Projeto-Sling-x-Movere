# ============================================
# Synkra AIOX Environment Configuration
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env with real credentials
# ============================================

# --------------------------------------------
# LLM Providers
# --------------------------------------------

# DeepSeek API (for claude-free command)
# Get your key at: https://platform.deepseek.com/api_keys
# Cost: ~$0.14/M tokens with tool calling support
DEEPSEEK_API_KEY=

# OpenRouter API (for multi-model routing)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Anthropic API (direct, if not using Claude Max subscription)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI API Key - Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --------------------------------------------
# Search & Research Tools
# --------------------------------------------

# Exa Search API (web search for agents)
# Get your key at: https://exa.ai/
EXA_API_KEY=

# Context7 (library documentation lookup)
# Usually free, no key required for basic usage
CONTEXT7_API_KEY=

# --------------------------------------------
# Database & Backend
# --------------------------------------------

# Supabase (database, auth, storage)
# Get from your Supabase project settings
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------
# Version Control & CI/CD
# --------------------------------------------

# GitHub Token (for GitHub CLI and API access)
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=

# --------------------------------------------
# Project Management
# --------------------------------------------

# ClickUp API (if using ClickUp integration)
# Get from: ClickUp Settings > Apps > API Token
CLICKUP_API_KEY=

# --------------------------------------------
# Automation & Workflows
# --------------------------------------------

# N8N (workflow automation)
# From your N8N instance settings
N8N_API_KEY=
N8N_WEBHOOK_URL=

# --------------------------------------------
# Monitoring & Analytics
# --------------------------------------------

# Sentry (error tracking)
SENTRY_DSN=

# --------------------------------------------
# Cloud Providers
# --------------------------------------------

# Railway (deployment)
RAILWAY_TOKEN=

# Vercel (deployment)
VERCEL_TOKEN=

# --------------------------------------------
# AIOX Core Configuration
# --------------------------------------------
NODE_ENV=development
AIOX_VERSION=5.4.1

# --------------------------------------------
# Custom Configuration
# --------------------------------------------
# Add your custom API keys below

# --------------------------------------------
# Banco de dados — PostgreSQL 16 (Movimento Gerais)
# --------------------------------------------
# Decisão de arquitetura: docs/architecture/tech-decisions.md (TD-02).
# Acesso vendor-neutro: a aplicação usa SOMENTE esta connection string padrão.
#
# Desenvolvimento local: `npm run db:up` sobe o Postgres via docker-compose.yml.
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
DATABASE_URL=

# Credenciais usadas pelo docker-compose.yml para provisionar o banco local.
# DEVEM ser as mesmas embutidas em DATABASE_URL acima.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432

# --------------------------------------------
# Autenticação — Auth.js / NextAuth v5 (Movimento Gerais)
# --------------------------------------------
# Decisão de arquitetura: docs/architecture/tech-decisions.md (TD-01).
#
# Chave de assinatura/criptografia do Auth.js. OBRIGATÓRIA.
# Gere uma nova (nunca reutilize entre ambientes) com:
#   npx auth secret
#   # ou: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# URL pública da aplicação. Necessária quando o app roda atrás de proxy reverso
# ou em domínio próprio. Em desenvolvimento (localhost) pode ficar vazia.
# Exemplo: https://painel.cirnepneus.com.br
AUTH_URL=

# Confia no host informado pelos cabeçalhos da requisição. Deixe `true` ao
# hospedar fora da Vercel (servidor próprio, Railway, Docker atrás de nginx).
AUTH_TRUST_HOST=

# --------------------------------------------
# Provisionamento do gestor inicial — `npm run db:seed` (Story 1.2, AC5)
# --------------------------------------------
# Não existe cadastro público (NFR3): este é o único caminho para criar o
# primeiro acesso. O script é idempotente — se o e-mail já existir, nada muda
# (inclusive a senha, que NÃO é sobrescrita).
#
# NUNCA preencha estes valores neste arquivo: ele é versionado (NFR4).
# Preencha somente no `.env` local, que está no .gitignore.
SEED_ADMIN_EMAIL=
# Mínimo de 12 caracteres.
SEED_ADMIN_PASSWORD=
# Opcional — nome exibido no painel.
SEED_ADMIN_NAME=

# --------------------------------------------
# Moveres Software ERP API (Movimento Gerais)
# --------------------------------------------
# Swagger: https://api.moveresoftware.com/swagger/ui/index#/
# Docs: https://meajuda.moveresoftware.com/a/solutions/articles/27000069342
MOVERE_API_BASE_URL=https://api.moveresoftware.com
MOVERE_API_ENVIRONMENT=
MOVERE_API_USER=
MOVERE_API_PASSWORD=
