{
  "name": "movimento-gerais",
  "version": "0.1.0",
  "private": true,
  "description": "Dashboard comercial da Cirne Pneus (Movimento Gerais)",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @movimento-gerais/web",
    "build": "npm run build --workspace @movimento-gerais/web",
    "start": "npm run start --workspace @movimento-gerais/web",
    "lint": "npm run lint --workspace @movimento-gerais/web",
    "typecheck": "npm run typecheck --workspace @movimento-gerais/web && tsc --noEmit -p tsconfig.seed.json",
    "test": "npm run test --workspace @movimento-gerais/web",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:import": "tsx prisma/import-sales-entries.ts",
    "sync:moveres": "tsx prisma/sync-moveres.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "devDependencies": {
    "@node-rs/argon2": "^2.1.0",
    "@prisma/client": "^6.19.0",
    "exceljs": "^4.4.0",
    "prisma": "^6.19.0",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
