{
  "name": "movimento-gerais",
  "version": "0.1.0",
  "private": true,
  "description": "Dashboard comercial da Cirne Pneus (Movimento Gerais)",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @movimento-gerais/web",
    "build": "npm run build --workspace @movimento-gerais/web",
    "start": "npm run start --workspace @movimento-gerais/web",
    "lint": "npm run lint --workspace @movimento-gerais/web",
    "typecheck": "npm run typecheck --workspace @movimento-gerais/web",
    "test": "npm run test --workspace @movimento-gerais/web",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "devDependencies": {
    "prisma": "^6.19.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
